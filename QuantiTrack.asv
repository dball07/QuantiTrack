function Untitled_7_Callback(hObject, eventdata, handles)
% hObject    handle to Untitled_5 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


% --- Executes on button press in AngleAnalysisButton.
function AngleAnalysisButton_Callback(hObject, eventdata, handles)
% hObject    handle to AngleAnalysisButton (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
defaults = {'10', num2str(handles.Parameters.Acquisition.frameTime), ...
    num2str(handles.Parameters.Analysis.Anisotropy_binT),...
    num2str(handles.Parameters.Analysis.Anisotropy_binD),...
    '1'};
prompt = {'Minimum track length (frames)',...
    'Frame interval (s)',...
    'Bin size for time (s)',...
    'Bin size for distance (nm)',...
    'Remove Angles with small steps'};
dlgtitle = 'Parameters for the Angle Analysis';
AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);

if isempty(AnalysisParam)
    return
end
minTrkLength = str2double(AnalysisParam{1});
frameTime = str2double(AnalysisParam{2});
binWidth_t = str2double(AnalysisParam{3});
binWidth_d = 1e-3*str2double(AnalysisParam{4});

Tracks = handles.PreAnalysis.Tracks_um;
frameTime = handles.Parameters.Acquisition.frameTime;
fileName = fullfile(handles.Data.pathName,handles.Data.fileName);
if str2double(AnalysisParam{5}) == 1
    pxSize = handles.Parameters.Acquisition.pixelSize;
    
    loc_prec = handles.Tracking.LocPrecision_px.*pxSize;
else
    loc_prec = 0;
end
AngleAnalysis_App(Tracks,[],2,frameTime,fileName,[binWidth_t,binWidth_d,loc_prec],handles.useParallel,get(gcf,'Position'));


