% hObject    handle to fitPSF (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hint: get(hObject,'Value') returns toggle state of fitPSF


% --------------------------------------------------------------------
function SetPar_Callback(hObject, eventdata, handles)
% hObject    handle to SetPar (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)



% --------------------------------------------------------------------
function SetAcqPar_Callback(hObject, eventdata, handles)
% hObject    handle to SetAcqPar (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
QT_location = getQuantiTrackLoc();
paramTab = 1; %Opens with Acquisition tab
profileEditor_gui = QuantiTrack_SetParams_App(handles.figure1, handles.Profiles,...
    handles.curProfileID,QT_location, paramTab, get(gcf,'Position'));

waitfor(profileEditor_gui);

%Retrieve the preprocessing results
OUTvars = getappdata(handles.figure1,'QuantiTrackParamEditorVals');
handles.Profiles = OUTvars{1};
handles.curProfileID = OUTvars{2};

handles = setParamValues(handles);


% Update handles structure
guidata(hObject, handles);





% --------------------------------------------------------------------
function SetCheckPar_Callback(hObject, eventdata, handles)
% hObject    handle to SetCheckPar (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

QT_location = getQuantiTrackLoc();
paramTab = 2; %Opens with Checking tab
profileEditor_gui = QuantiTrack_SetParams_App(handles.figure1, handles.Profiles,...
    handles.curProfileID,QT_location, paramTab, get(gcf,'Position'));

waitfor(profileEditor_gui);

%Retrieve the preprocessing results
OUTvars = getappdata(handles.figure1,'QuantiTrackParamEditorVals');
handles.Profiles = OUTvars{1};
handles.curProfileID = OUTvars{2};

handles = setParamValues(handles);


% Update handles structure
guidata(hObject, handles);



% --------------------------------------------------------------------
function SetAnPar_Callback(hObject, eventdata, handles)
% hObject    handle to SetAnPar (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

QT_location = getQuantiTrackLoc();
paramTab = 3; %Opens with Analysis tab
profileEditor_gui = QuantiTrack_SetParams_App(handles.figure1, handles.Profiles,...
    handles.curProfileID,QT_location, paramTab, get(gcf,'Position'));

waitfor(profileEditor_gui);

%Retrieve the preprocessing results
OUTvars = getappdata(handles.figure1,'QuantiTrackParamEditorVals');
handles.Profiles = OUTvars{1};
handles.curProfileID = OUTvars{2};

handles = setParamValues(handles);


% Update handles structure
guidata(hObject, handles);


% --------------------------------------------------------------------
function LoadMat_Callback(hObject, eventdata, handles)
% hObject    handle to LoadMat (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Open MatLab file and get variables
if ~isfield(handles,'Data') || ~isfield(handles.Data,'pathName') || isempty(handles.Data.pathName)
    def_path = pwd;
else
    def_path = handles.Data.pathName;
end
title_str = 'Select Matlab File with tracked data';
if ~ispc; menu(title_str,'OK'); end
[FileName,PathName,FilterIndex] = ...
    uigetfile('.mat',title_str,def_path);

if FileName ~=0
    set(handles.StatusText,'String','Loading Tracking data file...');
    drawnow;
    ListVar = whos('-file',[PathName,FileName]);
    
else
    return
end
% Reset the data content of the GUI
handles.Process = [];
handles.Parameters.Used = [];
handles.Tracking = [];
handles.Analysis = [];
handles.PreAnalysis = [];
handles.Current = [];
handles.Current.Ix = 1;
handles.isFitPSF = 0;
handles.arePeaksFiltered = 0;


%Load all the contents of the structure.
IN = load([PathName,FileName], 'Results');

handles.Data =  IN.Results.Data;
%         handles.Data.fileName = FileName;
%         handles.Data.pathName = PathName;
Parameters = IN.Results.Parameters;
handles.Process = IN.Results.Process;
handles.Tracking = IN.Results.Tracking;
handles.isFitPSF = IN.Results.isFitPSF;
handles.PreAnalysis = IN.Results.PreAnalysis;
if isfield(IN.Results,'arePeaksFiltered')
    handles.arePeaksFiltered = IN.Results.arePeaksFiltered;
else
    handles.arePeaksFiltered = 0;
end
newFigTitle = [handles.figTitle,' - ', handles.Data.fileName];
    set(handles.figure1,'Name',newFigTitle);

if ~isfield(handles.Data,'imageStack')
    try
        [handles.Data.imageStack,nImages] = TIFread(fullfile(handles.Data.pathName,handles.Data.fileName));
    catch
        title_str = 'Could not open Image, Specify File';
        if ~ispc; menu(title_str,'OK'); end
        [handles.Data.fileName, handles.Data.pathName] = uigetfile('*.tif','Could not open Image, Specify File',handles.Data.pathName);
        if handles.Data.fileName == 0
            return
        end
        [handles.Data.imageStack,nImages] = TIFread(fullfile(handles.Data.pathName,handles.Data.fileName));
    end
    for i = 1:nImages
        handles.Process.filtStack(i).data = ...
            bpass(handles.Data.imageStack(i).data,Parameters.Tracking(1), Parameters.Tracking(2));
    end
    
end

% Disable some of the controls
% [They will be re-enabled if the variables are found within the input file]

% Disable the otpions to visualize hand checked tracks
set(handles.TrackPopUp, 'Value',1);
set(handles.TrackPopUp, 'Enable', 'off');

% Disable the options to visualize filtered images
set(handles.imagePopup, 'Value',1);
set(handles.imagePopup, 'Enable', 'off');


% Disable the options to visualize localized particles
set(handles.showParticles, 'Value', 0);
set(handles.showParticles, 'Enable', 'off');
set(handles.SpotTrainMenu,'Enable','off');
set(handles.ParticlePopup, 'Enable','off');
set(handles.ParticlePopup, 'Value',1);
% Disable the options to visualize the tracks
set(handles.showTracks, 'Value', 0);
set(handles.showTracks, 'Enable', 'off');

%Enable filter button & roiButton
set(handles.filterButton,'Enable','on');
set(handles.roiButton,'Enable','on');
set(handles.LoadROIfromFile,'Enable','on');
set(handles.lpEdit,'Enable','on');
set(handles.hpEdit,'Enable','on');
if isfield(handles.Process, 'RefImage')
    set(handles.RemRefImage,'Enable','on');
end
%Enable File menu functions
set(handles.SaveMat,'Enable','on');
set(handles.SaveToDatabase,'Enable','on');

% set(handles.SaveMatNoImage,'Enable','on');
set(handles.ExportToWorkSpace,'Enable','on');
set(handles.ExportParamsMenu,'Enable','on');
set(handles.LoadFiltImageMenu,'Enable','on');

%Enable Tool Menu functions
set(handles.TrackDim_menu,'Enable','on');
set(handles.TrackIntPlotMenu,'Enable','on');
set(handles.Gmask_tracks,'Enable','on');

set(handles.ImportMMorphROIs,'Enable','on');
set(handles.ImportImageJROIs,'Enable','on');


% reset current index.
handles.Current = [];
handles.Current.Ix = 1;

% Select current image and set colormap limits.
handles.Current.Image = handles.Data.imageStack(handles.Current.Ix).data;
MaxBrightness = zeros(handles.Data.nImages,1);
MinBrightness = zeros(handles.Data.nImages,1);
for i = 1:handles.Data.nImages
    MaxBrightness(i) = max(handles.Data.imageStack(i).data(:));
    MinBrightness(i) = min(handles.Data.imageStack(i).data(:));
end
handles.Data.MaxBrightnessStack = 2*max(MaxBrightness); %give a 100% buffer above the maximum
handles.Data.clims = [min(MinBrightness),max(MaxBrightness)];
handles.Current.clims = handles.Data.clims;
set(handles.BlackValEdit,'String',num2str(handles.Current.clims(1)));
set(handles.BlackValSlider,'Min',0,'Max',(2^16 -1));
set(handles.BlackValSlider,'Value',handles.Current.clims(1));
set(handles.BlackValSlider,'SliderStep',[1/(2^16-2),10/(2^16-2)]);

set(handles.WhiteValEdit,'String',num2str(handles.Current.clims(2)));
set(handles.WhiteValSlider,'Min',0,'Max',(2^16 -1));
set(handles.WhiteValSlider,'Value',handles.Current.clims(2));
set(handles.WhiteValSlider,'SliderStep',[1/(2^16-2),10/(2^16-2)]);
% Display current Image

colormap(gray);
set(handles.axes1,'NextPlot','replace');
imagesc(handles.Current.Image, handles.Current.clims);
axis image;
set(handles.axes1, 'XTickLabel',[]);
set(handles.axes1, 'YTickLabel',[]);
impixelinfo;

% Enable the image slider
if handles.Data.nImages > 1
    % Set Minimum of image slider
    set(handles.imageSlider,'Min', handles.Current.Ix);
    % Set Maximum of image slider
    set(handles.imageSlider,'Max', handles.Data.nImages);
    % Set Value of image slider
    set(handles.imageSlider,'Value', handles.Current.Ix);
    % Set Step of image slider
    set(handles.imageSlider, 'SliderStep', [1/(handles.Data.nImages-1)...
        1/(handles.Data.nImages-1)]);
    % Set Image counter
    set(handles.imageCounter, 'String', ['Image ', ...
        num2str(handles.Current.Ix),'/',num2str(handles.Data.nImages)]);
end


% Check if there is the filtered stack
if isfield(handles.Process, 'filterStack')
    % Enable the options to visualize filtered images
    set(handles.imagePopup, 'Value',1);
    set(handles.imagePopup, 'Enable', 'on');
    set(handles.thresholdEdit,'Enable','on');
    set(handles.windowEdit,'Enable','on');
    set(handles.fitPSF,'Enable','on');
    if ~isfield(handles.Process,'filterType')
        handles.Process.filterType = 1;
    end
    set(handles.filterTypePopup,'Value',handles.Process.filterType);
    set(handles.filterTypePopup,'Enable','on');
    set(handles.findpeakButton,'Enable','on');
    handles.Process.clims = [min(min(handles.Process.filterStack(handles.Current.Ix).data)) ...
        max(max(handles.Process.filterStack(handles.Current.Ix).data))];
    set(handles.SaveFilterMenu,'Enable','on');
    MaxBrightness = zeros(handles.Data.nImages,1);
    for i = 1:handles.Data.nImages
        MaxBrightness(i) = max(handles.Process.filterStack(i).data(:));
    end
    handles.Process.MaxBrightnessStack = 2*max(MaxBrightness); %give a 100% buffer above the maximum
end
%Check if there is ROI data
if isfield(handles.Process,'ROIpos')
    nROIs = length(handles.Process.ROIpos);

    set(handles.ROIList,'String',handles.Process.ROIlabel);
    if size(handles.Process.ROIpos,2) > 1
        ROI = handles.Process.ROIpos(:,handles.Current.Ix);
    else
        ROI = handles.Process.ROIpos(:,1);
    end
    plotROI(ROI);
    set(handles.ROIList,'Value',1);
    set(handles.roiRemovePush,'Enable','on');
    set(handles.roiNamePush,'Enable','on');
    set(handles.CopyROI,'Enable','on');
    set(handles.StandardROIbutton,'Enable','on');
    set(handles.ChangeROIClass,'Enable','on');
    set(handles.ROIareas2clip_menu,'Enable','on');
    if ~isfield(handles.Process,'ROIClass')
        handles.Process.ROIClass = [];
    end
    %Reset the Classification display

    if ~isempty(handles.Process.ROIClass) && iscell(handles.Process.ROIClass{1,:}(1))
        set(handles.ROIClassCur_text,'String',handles.Process.ROIClass{1,:});
    else
        set(handles.ROIClassCur_text,'String','Not Defined');
    end
else
    set(handles.ROIClassCur_text,'String','');


end

if ~isfield(handles.Process,'ROIarea_px')
    for i = 1:size(handles.Process.ROIimage,1)
        for j = 1:size(handles.Process.ROIimage,2)
            handles.Process.ROIarea_px(i,j) = sum(sum(handles.Process.ROIimage{i,j}));
        end
    end

end

px_len = handles.Parameters.Acquisition.pixelSize;
px_area = px_len.^2;

ROIarea_um = px_area.*handles.Process.ROIarea_px(1,1);
str = sprintf('%3.2d pixels, %3.1f sq. um', handles.Process.ROIarea_px(1,1),ROIarea_um);

set(handles.ROIareaField,'String', str);

% Check if there is the data about the particles;
if isfield(handles.Tracking, 'Centroids')
    % Check if there particles are fit with gaussians
    set(handles.PixelTcourse,'Enable','on');
    if isfield(handles.Tracking, 'Particles')
        if handles.arePeaksFiltered == 1
            set(handles.ParticlePopup,'Enable','on');
            set(handles.ParticlePopup,'Value',1);
        end
        Centroids =  handles.Tracking.Particles;
        plotParticle(Centroids,handles.Current.Ix,handles.isFitPSF);
        set(handles.TrackingMethodPopup,'Enable','on');
        set(handles.TrackingMethodPopup,'Value',1);
        set(handles.SpotTrainMenu,'Enable','on');
    else

        Centroids =  handles.Tracking.Centroids;
        plotParticle(Centroids,handles.Current.Ix,handles.isFitPSF);
        set(handles.TrackingMethodPopup,'Enable','off');
        set(handles.TrackingMethodPopup,'Value',1);
    end

    set(handles.showParticles, 'Value', 1);
    set(handles.showParticles, 'Enable','on');

    set(handles.jumpEdit,'Enable','on');

    set(handles.shTrackEdit,'Enable','on');
    set(handles.gapsCheck,'Enable','on');
    set(handles.trackButton,'Enable','on');
    set(handles.fitPSF,'Value',handles.isFitPSF);
    set(handles.TrackingMethodPopup,'Enable','on');
else
    set(handles.PixelTcourse,'Enable','off');
end

% Check if there is information about tracks;
if isfield(handles.Tracking, 'Tracks')
    if isfield(handles.Tracking,'Method')
        set(handles.TrackingMethodPopup,'Value',handles.Tracking.Method);
    else
        set(handles.TrackingMethodPopup,'Value',1);
    end
    handles.Current.Tracks = handles.Tracking.Tracks;
    plotTracks(handles.Current.Tracks, handles.Current.Ix);
    set(handles.showTracks, 'Value', 1);
    set(handles.showTracks, 'Enable', 'on');
    set(handles.CheckTrackMenu,'Enable','on')
    set(handles.Track_Preprocess,'Enable','on');
    
end

if isfield(handles,'PreAnalysis')
    set(handles.HistD_Analysis,'Enable','on');
    set(handles.MSD_Analysis,'Enable','on');
    set(handles.AngleAnalysisButton,'Enable','on');
    set(handles.Bound_Analysis,'Enable','on');
    set(handles.ExportParamsMenu,'Enable','on');
    set(handles.AngleAnalysisButton,'Enable','on');
end

% Check if there are hand checked tracks
if isfield(handles.Tracking, 'CheckTracks')
    handles.Current.Tracks = handles.Tracking.CheckTracks;
    set(handles.TrackPopUp, 'Value',2);
    set(handles.TrackPopUp, 'Enable', 'on');
end


%store tracking parameters;
if isfield(Parameters, 'Tracking')
    handles.Parameters.Used.Tracking = Parameters.Tracking;
    set(handles.lpEdit, 'String', num2str(min(handles.Parameters.Used.Tracking(1:2))));
    set(handles.hpEdit, 'String', num2str(max(handles.Parameters.Used.Tracking(1:2))));
    set(handles.thresholdEdit, 'String', num2str(handles.Parameters.Used.Tracking(3)));
    set(handles.windowEdit, 'String', num2str(handles.Parameters.Used.Tracking(4)));
    if length(handles.Parameters.Used.Tracking) > 4
        set(handles.jumpEdit, 'String', num2str(handles.Parameters.Used.Tracking(5)));
        set(handles.gapsCheck, 'String', num2str(handles.Parameters.Used.Tracking(6)));
        set(handles.shTrackEdit, 'String', num2str(handles.Parameters.Used.Tracking(7)));
    end
end

% check if there are acquisition parameters.

if isfield(Parameters,'Acquisition')
    handles.Parameters.Acquisition = Parameters.Acquisition;
    set(handles.pixelSizeNM_edit,'String',num2str(handles.Parameters.Acquisition.pixelSize*1000));
    set(handles.frameTime_edit,'String',num2str(handles.Parameters.Acquisition.frameTime));
    if isfield(handles.Parameters.Acquisition,'NA')
        set(handles.NAedit,'String',num2str(handles.Parameters.Acquisition.NA));
    else
        handles.Parameters.Acquisition.NA = str2double(get(handles.NAedit,'String'));

    end
    if isfield(handles.Parameters.Acquisition,'EmWavelength')
        set(handles.lambda_nm_edit,'String',num2str(1000.*handles.Parameters.Acquisition.EmWavelength));
    else
        handles.Parameters.Acquisition.EmWavelength = str2double(get(handles.lambda_nm_edit,'String'))/1000;
    end
    if isfield(handles.Parameters.Acquisition,'exposureTime')
        set(handles.exposureTime_edit,'String',num2str(handles.Parameters.Acquisition.exposureTime));
    else
        handles.Parameters.Acquisition.exposureTime = str2double(get(handles.exposureTime_edit,'String'));
    end



    handles.Parameters.Used.Acquisition = Parameters.Acquisition;
end
%check if there is localization precision information
if isfield(handles.Tracking,'LocPrecision_px')
    pxSize = handles.Parameters.Acquisition.pixelSize;
    loc_prec_nm = handles.Tracking.LocPrecision_px(1).*pxSize.*1000;
    set(handles.locPrecisionText,'String',['Localization Precision: ', num2str(loc_prec_nm,4), ' nm']);

end

% check if there are checking parameters.

if isfield(Parameters, 'discardCheck')
    handles.Parameters.discardCheck = Parameters.discardCheck;
    handles.Parameters.Used.discardCheck = Parameters.discardCheck;
end

% check if there are analysis parameters.

if isfield(Parameters, 'Analysis')
    handles.Parameters.Analysis = Parameters.Analysis;
    handles.Parameters.Used.Analysis = Parameters.Analysis;
end

% check if there are parameters for the bound molecules.

if isfield(Parameters, 'Bound')
    handles.Parameters.Bound = Parameters.Bound;
    handles.Parameters.Used.Bound = Parameters.Bound;
end

set(handles.autoROImenu,'Enable','on');
set(handles.autoROIsLarge,'Enable','on');



set(handles.StatusText,'String','Loading Tracking data file...Done');
drawnow;


% Update handles structure
guidata(hObject, handles);


% --------------------------------------------------------------------
function SaveMat_Callback(hObject, eventdata, handles)
% hObject    handle to SaveMat (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Assign .mat file where variables will be saved.

if strcmp(handles.Data.pathName,'OMERO')
    answer = questdlg(['File will be saved to OMERO server, do you want to also save ' ...
        'a local copy'],'Save Local Version','Yes','No','Yes');
    if strcmp(answer,'Yes')
        savelocal_flag = 1;
        defName = fullfile(pwd, handles.Data.fileName);
        SearchStr = '(.*)\.\w*';
        defName = regexprep(defName, SearchStr, '$1');
        FilterSpec = {'*.mat'};
        [FileNameOut,PathNameOut] = uiputfile(FilterSpec,'Save Variables',defName);

    else
        savelocal_flag = 0;
    end
else
    savelocal_flag = 1;
    defName = [handles.Data.pathName, handles.Data.fileName];
    SearchStr = '(.*)\.\w*';
    defName = regexprep(defName, SearchStr, '$1');
    FilterSpec = {'*.mat'};
    [FileNameOut,PathNameOut] = uiputfile(FilterSpec,'Save Variables',defName);
    
end

if savelocal_flag == 1
    if FileNameOut ~=0
        if ~strcmp(FileNameOut(end-3:end),'.mat')
            FileNameOut = [FileNameOut,'.mat'];
        end
        tic
        set(handles.StatusText,'String','Saving MAT file...');
        drawnow;
        Version = 1.0;
        
        if ~isempty(handles.Process.ROIClass) && iscell(handles.Process.ROIClass{1,:})
            splitClassStr = questdlg('Do you want to save seperate files for each class?','Save Class-specific','Yes','No','No');
            if strcmp(splitClassStr,'Yes')
                splitClass = 1;
            else
                splitClass = 0;
            end
        else
            splitClass = 0;
        end

        if splitClass == 0
            Results.Data = handles.Data;
            Results.Parameters = handles.Parameters.Used;
            Results.Process = handles.Process;
            Results.Tracking = handles.Tracking;
            Results.Analysis = handles.Analysis;
            if isfield(handles,'PreAnalysis')
                Results.PreAnalysis = handles.PreAnalysis;
            end
            Results.isFitPSF = handles.isFitPSF;
            Results.arePeaksFiltered = handles.arePeaksFiltered;
            save([PathNameOut, FileNameOut], 'Version','Results', '-v7.3');
        else
            %determine the unique class names
            ROIsinClass = cell(length(handles.Process.AllROIClasses),1);

            for i = 1:length(handles.Process.AllROIClasses)
                for j = 1:length(handles.Process.ROIClass)
                    if strcmp(handles.Process.AllROIClasses{i,:},handles.Process.ROIClass{j,:})
                        ROIsinClass{i,:} = [ROIsinClass{i,:}; j];
                    end
                end
            end
            for i = 1:length(ROIsinClass)
                Results.Process.ROIClass = cell(length(ROIsinClass{i,:}),1);
                Results.Process.ROIlabel = cell(length(ROIsinClass{i,:}),1);
                Results.Process.ROIpos = cell(length(ROIsinClass{i,:}),1);
                Results.Process.ROIimage = cell(length(ROIsinClass{i,:}),1);
                Results.Process.ROIarea_px = zeros(length(ROIsinClass{i,:}),1);
                %set up the variables to save for each class
                if iscell(handles.Process.AllROIClasses{i,:})
                    ClassName = handles.Process.AllROIClasses{i,:}{1};
                else
                    ClassName = handles.Process.AllROIClasses{i,:};
                end
                %alter the save name to include the class name
                FnameOut = [FileNameOut(1:end-4),'_',ClassName,'.mat'];

                %copy the data & parameters
                Results.Data = handles.Data;
                Results.Parameters = handles.Parameters.Used;
                Results.Process.AllROIClasses{1,:} = ClassName;
                Results.isFitPSF = handles.isFitPSF;
                Results.arePeaksFiltered = handles.arePeaksFiltered;
                if isfield(handles.Process,'autoROIparamUsed')
                    Results.Process.autoROIparamUsed = handles.Process.autoROIparamUsed;
                end
                Results.Process.filterStack = handles.Process.filterStack;
                Results.Process.filterType = handles.Process.filterType;
                Results.Process.clims = handles.Process.clims;
                Results.Process.MaxBrightnessStack = handles.Process.MaxBrightnessStack;

                %copy the general Tracking varibles
                Results.Tracking.Method = handles.Tracking.Method;
                % Results.Tracking.Peaks = handles.Tracking.Peaks;

                Centroids = [];
                Tracks = [];
                if isfield(handles.Tracking,'Particles')
                    Particles = [];
                    Results.Tracking.TrackedFiltParticles = handles.Tracking.TrackedFiltParticles;
                end
                %copy the general PreAnalysis variables
                if isfield(handles,'PreAnalysis')
                    Results.PreAnalysis.IntensityHist = handles.PreAnalysis.IntensityHist;
                    Results.PreAnalysis.NParticles = handles.PreAnalysis.NParticles(:,1);

                    Tracks_um = [];
                end

                for j = 1:length(ROIsinClass{i,:})
                    %Get Process variables for the current class
                    Results.Process.ROIClass{j,:} = ClassName;
                    Results.Process.ROIlabel{j,:} = handles.Process.ROIlabel{ROIsinClass{i,:}(j),:};
                    Results.Process.ROIpos{j,:} = handles.Process.ROIpos{ROIsinClass{i,:}(j),:};
                    Results.Process.ROIimage{j,:} = handles.Process.ROIimage{ROIsinClass{i,:}(j),:};
                    Results.Process.ROIarea_px(j,:) = handles.Process.ROIarea_px(ROIsinClass{i,:}(j),:);

                    %Get Tracking variables for the current class
                    Centroids = [Centroids; handles.Tracking.Centroids(handles.Tracking.Centroids(:,7) == ROIsinClass{i,:}(j),:)];
                    Tracks = [Tracks; handles.Tracking.Tracks(handles.Tracking.Tracks(:,5) == ROIsinClass{i,:}(j),:)];
                    if isfield(handles.Tracking,'Particles')
                        Particles = [Particles; handles.Tracking.Particles(handles.Tracking.Particles(:,13) == ROIsinClass{i,:}(j),:)];
                    end

                    %Get the PreAnalysis variables for the current class
                    if isfield(handles,'PreAnalysis')
                        Tracks_um = [Tracks_um; handles.PreAnalysis.Tracks_um(handles.PreAnalysis.Tracks_um(:,5) == ROIsinClass{i,:}(j),:)];
                        Results.PreAnalysis.NParticles = [Results.PreAnalysis.NParticles, handles.PreAnalysis.NParticles(:,ROIsinClass{i,:}(j)+1)];
                    end

                end
                Results.Tracking.Centroids = Centroids;
                Results.Tracking.Tracks = Tracks;
                if isfield(handles.Tracking,'Particles')
                    Results.Tracking.Particles = Particles;
                end

                if isfield(handles,'PreAnalysis')
                    Results.PreAnalysis.Tracks_um = Tracks_um;
                end
                %save the file
                save([PathNameOut, FnameOut], 'Version','Results', '-v7.3');

            end
        end

        set(handles.StatusText,'String','Saving MAT file...Done');
        drawnow;
    else
        set(handles.StatusText,'String','Saving MAT file...Aborted');

        drawnow;
        return;
    end
end

if strcmp(handles.Data.pathName,'OMERO')
    tic
    set(handles.StatusText,'String','Saving MAT file...');
    drawnow
    mkdir([pwd,filesep,'OMERO_temp_save']);

    tmpsave_file = fullfile([pwd,filesep,'OMERO_temp_save'],[handles.Data.fileName(1:end-4),'_tracking.mat']);

    Version = 1.0;

    Results.Data.fileName = handles.Data.fileName;
    Results.Data.pathName = handles.Data.pathName;
    Results.Data.nImages = handles.Data.nImages;
    Results.Data.clims = handles.Data.clims;
    %OMERO-specific parameters
   

    Results.Data = handles.Data;
    Results.Parameters = handles.Parameters.Used;
    Results.Process = handles.Process;
    Results.Tracking = handles.Tracking;
    Results.Analysis = handles.Analysis;
    if isfield(handles,'PreAnalysis')
        Results.PreAnalysis = handles.PreAnalysis;
    end
    Results.isFitPSF = handles.isFitPSF;
    Results.arePeaksFiltered = handles.arePeaksFiltered;
    Results.Data.OMERO_ProjectID = getappdata(0,'OMEROProjectID');
    Results.Data.OMERO_DatasetID  = getappdata(0,'OMERODatasetID');
    Results.Data.OMERO_ImageID = getappdata(0,'OMEROImageID');
    Results.Data.OMERO_ChannelN = getappdata(0,'OMEROChannelSelect');


    save(tmpsave_file, 'Version','Results', '-v7.3');

    %start a session with the last used OMERO server
    OMEROserverIP = getappdata(0,'OMEROserverIP');
    OMEROserverPort = getappdata(0,'OMEROserverPort');
    OMEROuser = getappdata(0,'OMEROuser');
    OMEROpwd = getappdata(0,'OMEROpwd');

    client = loadOmero(OMEROserverIP,OMEROserverPort);
    session = client.createSession(OMEROuser,OMEROpwd);

    fa = writeFileAnnotation(session,tmpsave_file);
    linkAnnotation(session,fa,'image',Results.Data.OMERO_ImageID);

    client.closeSession();
    clear session;
    clear client;

    rmdir([pwd,filesep,'OMERO_temp_save'],'s');
    set(handles.StatusText,'String','Saving MAT file...Done');
    t_save = toc;
    drawnow;
end



