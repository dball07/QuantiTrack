% --------------------------------------------------------------------
function TrackTableGenMenu_Callback(hObject, eventdata, handles)
% hObject    handle to TrackTableGenMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
trackingSaveDir = handles.Profiles(handles.curProfileID).trackingSaveDir;
lastCellProtein = handles.Profiles(handles.curProfileID).lastCellProtein;
def_dir = fullfile(trackingSaveDir,lastCellProtein);

title_str = 'Select directory where data are located';
if ~ispc; menu(title_str,'OK'); end
parentpath = uigetdir(def_dir,'Select directory where data are located');
if parentpath == 0
    return
end
pxSize_def = num2str(handles.Profiles(handles.curProfileID).pixelSize);
expTime_def = num2str(handles.Profiles(handles.curProfileID).exposureTime);
intervalTime_def = num2str(handles.Profiles(handles.curProfileID).frameTime);


prompt = {'Enter pixel size (um/pixel):', 'Enter exposure time (s):', 'Enter acquisition interval (s):'};
dlgtitle = 'Acquisition parameter input';
dims = [1 35];
definput = {pxSize_def, expTime_def, intervalTime_def};

acqParam  = inputdlg(prompt, dlgtitle, dims, definput);
if isempty(acqParam)
    return
else
    pixelSize_base   = str2double(acqParam{1});     % pixel size
    expTime  = str2double(acqParam{2});
    intervalTime = str2double(acqParam{3});
    genFullTrackTable(parentpath,pixelSize_base, expTime, intervalTime);
end


