% --------------------------------------------------------------------
function PixelTcourse_Callback(hObject, eventdata, handles)
% hObject    handle to PixelTcourse (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

imStack = handles.Data.imageStack;
if handles.isFitPSF
    part = [handles.Tracking.Particles(:,10), handles.Tracking.Particles(:,11), handles.Tracking.Particles(:,6)];
else
    part = [handles.Tracking.Centroids(:,1:2), handles.Tracking.Centroids(:,6)];
end

prompt = {['Select the frame from which to take particle locations (1-', num2str(handles.Data.nImages), ')'] };

dlgtitle = 'Choose Frame';
definputs = {'1'};

frame = inputdlg(prompt,dlgtitle,1,definputs);

if str2double(frame) >= 1 && str2double(frame) <= handles.Data.nImages
    partFrame = part(part(:,3) == str2double(frame),1:2);
    partFrame = round(partFrame);
    for i = 1:length(partFrame)
        curPos = partFrame(i,:);
        IntTcourse(:,i) = measurePixelInt(imStack,curPos(2),curPos(1));
    end

    num2clip(IntTcourse);
    msgbox('Intensity time-courses copied to clipboard')


end



