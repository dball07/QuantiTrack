function RLanalysisMenu_Callback(hObject, eventdata, handles)
% hObject    handle to RLanalysisMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%Ask the user to select the trackTable file to analyze
title_str = 'Select TrackTable file for RL analysis';
if ~ispc; menu(title_str,'OK'); end
[trackTable_file, trackTable_path] = uigetfile('*.mat','Select TrackTable file for RL analysis',pwd);

if trackTable_file ~= 0
    IN = load(fullfile(trackTable_path,trackTable_file));

    if isfield(IN,'trackTable')
        %Get parameters
        prompt = {'Lag time (frames):',...
            'Number of bins in vHC:',...
            'Minimum jump distance (um):',...
            'Maximum jump distance (um):',...
            'Filter out immobile molecules:',...
            'Maximum D for immobile (um2/s):',...
            'Minimum track length (frames):',...
            'Fitting iterations:',...
            'Min. MSD for plotting:',...
            'Max. MSD for plotting:',...
            'Number of MSD bins'};
        dlgtitle = 'RL analysis parameters';
        dims = [1 70];
        definput = {'5',...
            '200',...
            '0.002',...
            '0.4',...
            '0',...
            '0.0019',...
            '7',...
            '50000',...
            '0.0001',...
            '0.25',...
            '400'};

        acqParam  = inputdlg(prompt, dlgtitle, dims, definput);
        if isempty(acqParam)
            return
        end
        
        lagtime = str2double(acqParam{1});
        nbins = str2double(acqParam{2});
        jump_thresh = str2double(acqParam{3});
        maxBin = str2double(acqParam{4});
        filtImmobile_flag = str2double(acqParam{5});
        immobileThresh = str2double(acqParam{6});
        minTrackLength = str2double(acqParam{7});
        Niter = str2double(acqParam{8});
        MSDmin = str2double(acqParam{9});
        MSDmax = str2double(acqParam{10});
        MSDnBins = str2double(acqParam{11});

        %run the batch Richardson-Lucy algorithm
        RL_BatchTrackAnalysis(IN.trackTable,trackTable_path, lagtime, nbins, jump_thresh, maxBin, filtImmobile_flag, immobileThresh, minTrackLength, Niter, MSDmin, MSDmax, MSDnBins);


    end
end


% --------------------------------------------------------------------
function CheckSNR_batch_Callback(hObject, eventdata, handles)
% hObject    handle to CheckSNR_batch (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

set(handles.StatusText,'String','Compiling SNR data...');
drawnow
%Select the files to analyze
if isfield(handles, 'Data')
    title_str = 'Select Mat files for SNR check';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for SNR check',...
        [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
else
    title_str = 'Select Mat files for SNR check';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for SNR check',...
        'MultiSelect','on');
end
if ~iscell(FileNames)
    tmp{1,1} = FileNames;
    FileNames = tmp;
end
if FileNames{1} == 0
    set(handles.StatusText,'String','Compiling SNR data...Aborted');
    drawnow
    return;
end

nFiles = length(FileNames);

if nFiles > 1
    [Tracks, ~, ~, ~, ~, Particle_SNR] = compileTracksFromFiles(FileNames,PathName,0,[],'Tracking');
    
    
else
    IN = load(fullfile(PathName,FileNames{1}));
    if isfield(IN,'trackTable')
        [Tracks, ~, ~, ~, ~, Particle_SNR] = compileTracksFromTables(IN.trackTable,0, [], 'Tracking');
    else
        [Tracks, ~, ~, ~, ~, Particle_SNR] = compileTracksFromFiles(FileNames,PathName,0,[],'Tracking');
    end
end

%rearrange the SNR values into a single column
SNR_all = [];
for i = 1:length(Particle_SNR)
    if Particle_SNR{i} ~= -1
        SNR_all = [SNR_all; Particle_SNR{i}];
    else
        %if the tracking file was generated from a older tracking software
        %it may not have the SNR values stored
        SNR_tmp = (Tracks{i}(:,6) - Tracks{i}(:,7))./sqrt(Tracks{i}(:,6));
        SNR_all = [SNR_all; SNR_tmp];

    end
end
%Calculate the fraction of SNRs less than 1.5
SNRlt1_5 = SNR_all(SNR_all<= 1.5);
fraclt1_5 = length(SNRlt1_5)./length(SNR_all);

binEdges_SNR = linspace(0,100,201);
dBin = binEdges_SNR(2) - binEdges_SNR(1);

binCents_SNR = (binEdges_SNR(1)+dBin/2):dBin:(binEdges_SNR(end)-dBin/2);
ind1_5 = find(binCents_SNR <= 1.5, 1,'last');

SNR_hist(:,1) = binCents_SNR(:);
SNR_hist(:,2) = histcounts(SNR_all,binEdges_SNR(:));

[maxBinVal, maxBin] = max(SNR_hist(:,2));

scrsz = get(0,'ScreenSize');
figure('Position',[.25*scrsz(3) .125*scrsz(4) .5*scrsz(3) .75*scrsz(4)]) ;

%Plot the histogram
bar(SNR_hist(ind1_5+1:end,1),SNR_hist(ind1_5+1:end,2),'b','EdgeColor', 'none');
hold('on');
bar(SNR_hist(1:ind1_5,1),SNR_hist(1:ind1_5,2),'r','EdgeColor', 'none');
maxPlot = SNR_hist(find(SNR_hist(:,2) ~= 0, 1,'last'),1);
xlim([0 maxPlot]);

if SNR_hist(maxBin,1) > (maxPlot - SNR_hist(maxBin,1))
    textX = 0.5;
else
    textX = SNR_hist(maxBin,1) + 0.5;
end
text(textX,maxBinVal-5,[num2str(100.*fraclt1_5,3),'% SNR < 1.5']);
xlabel('SNR');
ylabel('Counts');
title('Signal to Noise histogram for tracked particles');

assignin('base','SNR_all',SNR_all);
% num2clip(SNR_all);
msgbox({'The Array containing the SNR data';...
    'has been copied to the workspace'});

set(handles.StatusText,'String','Compiling SNR data...Done');
drawnow


% --------------------------------------------------------------------
function TrackQC_batch_Callback(hObject, eventdata, handles)
% hObject    handle to TrackQC_batch (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

set(handles.StatusText,'String','Compiling Nearest Neighbor data...');
drawnow
%Select the files to analyze
if isfield(handles, 'Data')
    title_str = 'Select Mat files for the analysis of the residence time';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for the analysis of the residence time',...
        [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
else
    title_str = 'Select Mat files for the analysis of the residence time';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for the analysis of the residence time',...
        'MultiSelect','on');
end
if ~iscell(FileNames)
    tmp{1,1} = FileNames;
    FileNames = tmp;
end
if FileNames{1} == 0
    set(handles.StatusText,'String','Compiling Nearest Neighbor data...Aborted');
    drawnow
    return;
end

nFiles = length(FileNames);

if nFiles > 1
    [Tracks, ~, ~, ~, ~, ~, Track_JumpDist1, Track_nextNearestD,Particles,pixelSize,maxJump] = compileTracksFromFiles(FileNames,PathName,0,[],'Tracking');
    
else
    IN = load(fullfile(PathName,FileNames{1}));
    if isfield(IN,'trackTable')
        [Tracks, ~, ~, ~, ~, ~, Track_JumpDist1, Track_nextNearestD,Particles,pixelSize,maxJump] = compileTracksFromTables(IN.trackTable,0, [], 'Tracking');
    else
        [Tracks, ~, ~, ~, ~, ~, Track_JumpDist1, Track_nextNearestD,Particles,pixelSize,maxJump] = compileTracksFromFiles(FileNames,PathName,0,[],'Tracking');
    end
end


%rearrange the NN values into a single column
NN_all = [];
NN2_all = [];

for i = 1:length(Track_JumpDist1)
    if size(Track_nextNearestD{i},1) > 1 || Track_nextNearestD{i}(1) ~= -1
        NN_all = [NN_all; Track_JumpDist1{i}];
        NN2_all = [NN2_all; Track_nextNearestD{1}(:,2)];
    else
        %if the tracking file was generated from a older tracking software
        %it may not have the SNR values stored
        tracks_cur = Tracks{i};
        tracks_cur(:,1:2) = tracks_cur(:,1:2)./pixelSize;
        [track_nn_tmp, track_nn2_tmp] = calcTrack_NN(tracks_cur,Particles{i});

        NN_all = [NN_all; track_nn_tmp];
        NN2_all = [NN2_all; track_nn2_tmp(track_nn2_tmp > 0)];
    end
end
%create the histograms
NN_Hist(:,1) = 0.5:maxJump-0.5;
nnBinEdges = 0:maxJump;
NN_Hist(:,2) = histcounts(NN_all,nnBinEdges);

scrsz = get(0,'ScreenSize');
figure('Position',[.15*scrsz(3) .15*scrsz(4) .5*scrsz(3) .5*scrsz(4)]);

%Plot the jump distance
subplot(1,2,1);

bar(NN_Hist(:,1),NN_Hist(:,2),1.0,'b');
xlim([0, maxJump]);
xlabel('1-frame jump distance (px)');
ylabel('Counts');
title('Verification of Max. Jump Value')

%Get the fraction of 2nd nearest neighbor under the maxmimum
%jump
track_nn2 = NN2_all(NN2_all >= 0,1);

frac_nn2_ltMJ = length(track_nn2(track_nn2<= maxJump)) ./ length(track_nn2);
per_nn2_ltMJ = 100*frac_nn2_ltMJ;


NN2_Hist(:,1) = 0.5:max(NN2_all)-0.5;
nn2BinEdges = 0:max(NN2_all);
NN2_Hist(:,2) = histcounts(NN2_all,nn2BinEdges);

maxJ_bin = find(NN2_Hist(:,1) > maxJump,1,'first');

%Plot the 2nd nearest neighbor
subplot(1,2,2);

bar(NN2_Hist(maxJ_bin:end,1),NN2_Hist(maxJ_bin:end,2),'b','EdgeColor','none');
hold('on');
bar(NN2_Hist(1:maxJ_bin-1,1),NN2_Hist(1:maxJ_bin-1,2),'r','EdgeColor','none');
xlim([0,NN2_Hist(end,1)+0.5]);
text(max(NN2_all(:,1))/2,3*max(NN2_Hist(:,2))/4,[num2str(per_nn2_ltMJ,3), '% within ', num2str(maxJump), ' px']);
xlabel('Distance to 2^{nd} Nearest Neighbor (px)');
ylabel('Counts');
title({'Probabilty of two particles within Max. Jump distance'})

set(handles.StatusText,'String','Compiling Nearest Neighbor data...Done');

% num2clip(NN2_all);
% msgbox({'The Array containing the Nearest Neighbor data';...
%     'has been copied to the clipboard'});



