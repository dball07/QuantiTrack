% --------------------------------------------------------------------
function angles_pEM_Callback(hObject, eventdata, handles)
% hObject    handle to angles_pEM (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
defaults = {'0.01','50','0.05', '0.8','50'};
prompt = {'Bin width for time (s)',...
    'Bin width for motion (nm)',...
    'Min. Fraction of Population of state)',...
    'Min. State Probability',...
    'Number of Bootstrap Iterations'};
dlgtitle = 'Parameters for Angle Analysis';

AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);

if isempty(AnalysisParam)
    return
end


binWidth_T = str2double(AnalysisParam{1});
binWidth_D = 1e-3*str2double(AnalysisParam{2});
FracThresh = str2double(AnalysisParam{3});
ProbThresh = str2double(AnalysisParam{4});
BootIter = str2double(AnalysisParam{5});

title_str = 'Select pEM results file to analyze';
if ~ispc; menu(title_str,'OK'); end
[pEM_file,pEM_path] = uigetfile('*.mat','Select pEM results file to analyze','pEM results');
if pEM_file == 0
    return
end
IN = load(fullfile(pEM_path,pEM_file));

[angles, AC_t, AC_d] = calcAngles3_subpops(IN.pEMTable,FracThresh,ProbThresh,binWidth_D,binWidth_T,BootIter,handles.useParallel);

optSize = IN.pEMTable.optimalSize;

%determine if there is data for any of the states
nAngles = zeros(optSize,1);
for i = 1:optSize
    nAngles(i) = size(angles{i},1);
end
if max(nAngles) > 0
    [file_out,path_out] = uiputfile('*.mat','Select Save Location');
    figure; t = tiledlayout(1,2);

    nexttile(t);
    hold on;
    leg_ind = 1;
    for i = 1:optSize
        if ~isempty(angles{i})
            errorbar(1e3*AC_t{i}(:,1),AC_t{i}(:,2),AC_t{i}(:,3),AC_t{i}(:,4));
            Legend_str{leg_ind,:} = ['State ', num2str(i)];
            leg_ind = leg_ind + 1;

        end
    end
    ylabel('Anisotropy (log_2(0/180))');
    xlabel('Time (ms)');
    legend(Legend_str);

    nexttile(t);
    hold on;
    leg_ind = 1;
    for i = 1:optSize
        if ~isempty(angles{i})
            errorbar(1e3*AC_d{i}(:,1),AC_d{i}(:,2),AC_d{i}(:,3),AC_d{i}(:,4));
            Legend_str{leg_ind,:} = ['State ', num2str(i)];
            leg_ind = leg_ind + 1;
        end
    end
    ylabel('Anisotropy (log_2(0/180))');
    xlabel('Distance (nm)');
    legend(Legend_str);

    if file_out ~= 0
        save(fullfile(path_out,file_out),"angles","AC_t","AC_d");
    end
end


% --------------------------------------------------------------------
function peM_CeqCalcMenu_Callback(hObject, eventdata, handles)
% hObject    handle to peM_CeqCalcMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%
%Have the user specify the residence time analysis file
title_str = 'Select the residence time analysis file (Cancel to enter n_total)';
if ~ispc; menu(title_str,'OK'); end
[ResFile, ResPath] = uigetfile('*.mat','Select the residence time analysis file (Cancel to enter n_total)');
if ResFile == 0
    defaults = {'1'};
    prompt = {'Enter the Total number of particles tracked:'};
    dlgtitle = 'Total Molecules';

    N_tot_struct = inputdlg(prompt,dlgtitle, 1, defaults);
    if isempty(N_tot_struct)
        return
    end
    ResFile_fullpath = str2double(N_tot_struct{1});
else
    ResFile_fullpath = fullfile(ResPath,ResFile);
end


%Have the user specify the pEM analysis file
title_str = 'Select the pEM analysis file';
if ~ispc; menu(title_str,'OK'); end
[pEMfile, pEMpath] = uigetfile('*.mat','Select the pEM analysis file');

if pEMfile == 0
    return
end
pEMfile_fullpath = fullfile(pEMpath,pEMfile);

defaults = {'1'};
prompt = {'Enter the state number(s) that are diffusive (seperate multiple states with comma)'};
dlgtitle = 'Diffusive States';

AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);

if isempty(AnalysisParam)
    return
end

diffStateID = eval(['[', AnalysisParam{1},']']);

Ceq_prime = calcBoundFrac(diffStateID,ResFile_fullpath,pEMfile_fullpath,1);

num2clip(Ceq_prime);
msgbox('Bound Fraction copied to clipboard');


