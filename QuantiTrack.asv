% --------------------------------------------------------------------
function SaveToDatabase_Callback(hObject, eventdata, handles)
% hObject    handle to SaveToDatabase (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%Call the save application to set up
trackingSaveDir = handles.Profiles(handles.curProfileID).trackingSaveDir;
lastCellProtein = handles.Profiles(handles.curProfileID).lastCellProtein;
lastCondition = handles.Profiles(handles.curProfileID).lastCondition;
lastSession = handles.Profiles(handles.curProfileID).lastSession;
lastName = handles.Data.fileName;

qt_save = QuantiTrack_SaveToDatabase(trackingSaveDir,lastCellProtein,...
    lastCondition,lastSession,lastName,handles.figure1, get(gcf,'Position'));
waitfor(qt_save);

hwait = waitbar(0,'Saving Tracking Data','Name','Save');
save_vars = getappdata(handles.figure1,'QuantiTrack_SavePars');
% setappdata(handles.figure1,'QuantiTrack_SavePars',[]);
if isempty(save_vars)
    close(hwait);
    return
end
if isempty(save_vars{1})
    close(hwait);
    return
end
%update the default values
handles.Profiles(handles.curProfileID).trackingSaveDir = save_vars{1};
handles.Profiles(handles.curProfileID).lastCellProtein = save_vars{2};
handles.Profiles(handles.curProfileID).lastCondition  = save_vars{3};
handles.Profiles(handles.curProfileID).lastSession  = save_vars{4};
handles.Profiles(handles.curProfileID).lastName = [save_vars{5}, '.mat'];

FileNameOut = [save_vars{5}, '.mat'];
PathNameOut = fullfile(handles.Profiles(handles.curProfileID).trackingSaveDir,handles.Profiles(handles.curProfileID).lastCellProtein, ... 
    handles.Profiles(handles.curProfileID).lastCondition, handles.Profiles(handles.curProfileID).lastSession);

if ~isempty(save_vars{1})
    %Set up the Results structure and save the tracking file
    set(handles.StatusText,'String','Saving File to Database...');
    drawnow;
    Results.Data = handles.Data;
    Results.Parameters = handles.Parameters.Used;
    Results.Process = handles.Process;
    Results.Tracking = handles.Tracking;
    Results.Analysis = handles.Analysis;
    if isfield(handles,'PreAnalysis')
        Results.PreAnalysis = handles.PreAnalysis;
    end
    Results.isFitPSF = handles.isFitPSF;
    Results.arePeaksFiltered = handles.arePeaksFiltered;
    
    
    Version = 1.0;
    save(fullfile(PathNameOut, FileNameOut), 'Version','Results', '-v7.3');
    
    trackTable = generateTrackTable(Results,handles.Profiles(handles.curProfileID));
    tt_saveLoc = fullfile(handles.Profiles(handles.curProfileID).trackingSaveDir,handles.Profiles(handles.curProfileID).lastCellProtein);

    %Check if there is an existing trackTable for this cell/protein
    preExistingTrackTable = dir(fullfile(tt_saveLoc,'trackTable*'));
    waitbar(0.5,hwait,'Saving Tracking Data','Name','Save');
    if ~isempty(preExistingTrackTable)
        input = load(fullfile(tt_saveLoc,preExistingTrackTable(1).name));
        t = input.trackTable;
        last_cellID = t.cellID(height(t));
        last_trackID = t.trackID{height(t)}(end);
        last_movieID = t.movieID(height(t));

        trackTable.cellID = trackTable.cellID + last_cellID;
        trackTable.movieID = trackTable.movieID + last_movieID;
        for i = 1:height(trackTable)
            trackTable.trackID{i} = trackTable.trackID{i} + last_trackID;
        end

        trackTable = [t; trackTable];
        save(fullfile(tt_saveLoc,preExistingTrackTable(1).name),'trackTable','-v7.3');
    else
        savename  = sprintf('trackTable_%s_%s.mat', handles.Profiles(handles.curProfileID).lastCellProtein, ...
            datestr(now, 'yyyy-mm-dd_THHMM'));
        save(fullfile(tt_saveLoc,savename),'trackTable','-v7.3');

    end
    waitbar(1,hwait,'Saving Tracking Data','Name','Save');
    %save the last used cell/protein, condition and session
    Profiles = handles.Profiles;
    lastProfile = handles.curProfileID;
    QT_location = getQuantiTrackLoc();
    
    Profiles(lastProfile).lastCellProtein = lastCellProtein;
    Profiles(lastProfile).lastCondition = lastCondition;
    Profiles(lastProfile).lastSession = lastSession;
    Profiles(lastProfile).lastName = lastName;

    save(fullfile(QT_location,'QuantiTrack_localDefaults.mat'), 'Profiles','lastProfile');
    

    set(handles.StatusText,'String','Saving File to Database...Done');
    drawnow;

end
%clear the preprocessing data stored by appdata
setappdata(0,'QuantiTrack_SavePars',[]);
close(hwait);
guidata(hObject,handles);





