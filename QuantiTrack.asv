function makeMoviesBatch_Callback(hObject, eventdata, handles)
% hObject    handle to makeMoviesBatch (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


% --------------------------------------------------------------------
function makeMoviesTrackFiles_Callback(hObject, eventdata, handles)
% hObject    handle to makeMoviesTrackFiles (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


% --------------------------------------------------------------------
function MovieFromTracking_Callback(hObject, eventdata, handles)
% hObject    handle to MovieFromTracking (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
if isfield(handles, 'Data')
    title_str = 'Select Tracking Files to make Movies';
    if ~ispc; menu(title_str,'OK'); end
    [files path] = uigetfile('.mat',...
        'Select Tracking Files to make Movies',...
        [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
else
    title_str = 'Select Tracking Files to make Movies';
    if ~ispc; menu(title_str,'OK'); end
    [files path] = uigetfile('.mat',...
        'Select Tracking Files to make Movies',...
        'MultiSelect','on');
end
if ~iscell(files)
    files_tmp{1} = files;
    files = files_tmp;
end

if files{1} == 0
    return
end
%Ask if the user wants to use the raw or filtered images
image2use = questdlg('Do you want to use the raw images or the filtered images','Raw or filtered','Raw','Filtered','Raw');

%Ask if user wants a 2D or 3D movie
movieType = questdlg('Do you want a 2D or 3D movie?','Movie Type','2D','3D','Cancel','2D');
if strcmp(movieType,'Cancel')
    return
end

if strcmp(movieType,'2D')
    %get the movie parameters
    defaults = {'50','4000','20', '0', '50', '5','1'};
    prompt = {'Black Level',...
        'White Level',...
        'Minimum track length to display', ...
        'Maximum time-point to display in movie (0 = all)', ...
        'Movie frame rate (1/s)',...
        'Scale bar length (um)', ...
        'Acquisition time interval (0 - no Time-stamp shown)'};
    dlgtitle = 'Movie parameters';
    MovParam = inputdlg(prompt,dlgtitle,1,defaults);
    blackLevel = str2double(MovParam{1});
    whiteLevel = str2double(MovParam{2});
    minTrkLen = str2double(MovParam{3});
    maxFrame = str2double(MovParam{4});
    movFrameRate = str2double(MovParam{5});
    scalebar_length = str2double(MovParam{6});
    timestamp_flag = str2double(MovParam{7});
    
else
    %get the movie parameters
    defaults = {'50','4000',...
        '20', ...
        '0.2',...
        '0', ...
        '50',...
        '0.94',...
        '1'};
    prompt = {'Movie Black Level','Movie White Level', ...
                        'Minimum Track Length to display', ...
                        'Acquisition time interval (s)',...
                        'Maximum Time-point to display in Movie (0 = all)', ...
                        'Movie Frame Rate (Max. 172) (1/s)'...
                        'Figure Background Graylevel',...
                        'Axes Background Graylevel',...
                        };
    dlgtitle = 'Movie parameters';
    MovParam = inputdlg(prompt,dlgtitle,1,defaults);
    blackLevel = str2double(MovParam{1});
    whiteLevel = str2double(MovParam{2});
    minTrkLen = str2double(MovParam{3});
    maxFrame = str2double(MovParam{5});
    movFrameRate = str2double(MovParam{6});
    if movFrameRate > 172
        fwarn = warndlg('Selected Frame rate exceeds maximum allowed. Setting to maximum value of 172','Frame Rate adjusted');
        waitfor(fwarn);
        movFrameRate = 172;
    end
    figGray = str2double(MovParam{7});
    axGray = str2double(MovParam{8});
    fig_bgColor = [figGray figGray figGray];
    ax_bgColor = [axGray axGray axGray];
    if fig_bgColor(1) < 0.5
        textColor = [1 1 1];
    else
        textColor = [0 0 0];
    end
    scalebar_length = 0;
    timestamp_flag = 0;
end
    


%loop through the files
for i = 1:length(files)
    IN = load(fullfile(path,files{i}));
%     frameTime = IN.Results.Parameters.Acquisition.frameTime;
    if strcmp(image2use,'Raw')
        stack = IN.Results.Data.imageStack;
    else
        stack = IN.Process.filterStack;
    end
    tracks = IN.Results.Tracking.Tracks;
    ROIpos = IN.Results.Process.ROIpos;
    pixelSize = IN.Results.Parameters.Acquisition.pixelSize;
    frameTime = IN.Results.Parameters.Acquisition.frameTime;
    minX = 1;
    maxY = stack(1).width;
    minY = 1;
    maxX = stack(1).height;

    % 
    

    if strcmp(movieType,'2D')
        
        FileNameOut = [files{i}(1:end-4),'_movie2D.mp4'];
        
        makeFlatTrackMovie(stack,tracks,ROIpos,frameTime,pixelSize,fullfile(path,FileNameOut), blackLevel,whiteLevel,minTrkLen,maxFrame,movFrameRate,minX,maxX,minY,maxY,scalebar_length,timestamp_flag);


    else
        FileNameOut = [files{i}(1:end-4),'_movie3D.mp4'];
        makePerspectiveTrackMovie(stack,tracks,frameTime,fullfile(path,FileNameOut), blackLevel,whiteLevel,minTrkLen,maxFrame,movFrameRate,minX,maxX,minY,maxY,fig_bgColor,ax_bgColor,textColor);

    end
end




