% --- Executes on button press in filterPartButton.
function filterPartButton_Callback(hObject, eventdata, handles)
% hObject    handle to filterPartButton (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%try to find the path the the trained models
matPath = path;
matTrack_str = strfind(matPath,'MatlabTrack_v');
sc = strfind(matPath,';');
ind1 = find(sc < matTrack_str(1),1,'last');
if isempty(ind1)
    ind1 = 0;
end
ind2 = find(sc > matTrack_str(1),1,'first');
if isempty(ind2)
    ind2 = length(matPath) + 1;
end

matTrack_D = matPath(sc(ind1)+1:sc(ind2)-1);
modelPath = [matTrack_D, filesep, 'Particle Training Sets'];

title_str = 'Select The Trained model file';
if ~ispc; menu(title_str,'OK'); end
[ai_part_fname, ai_part_pname] = uigetfile('*.mat','Select The Trained model file',modelPath);
set(handles.StatusText,'String','Filtering Particles...');
drawnow;
if ai_part_fname ~= 0
    IN = load(fullfile(ai_part_pname,ai_part_fname));
    B = IN.BagOtrees;
    Particles = handles.Tracking.Particles;

    pred = Particles(:,[4,7,8,9,12,14:18]);
    Yfit = predict(B,pred);
    resp = zeros(size(pred,1),1);
    for i = 1:length(resp)
        resp(i) = str2double(Yfit{i});
    end
    handles.Tracking.filtParticles = Particles(resp == 1,:);
    handles.arePeaksFiltered = 1;
    set(handles.ParticlePopup,'Enable','on');
    set(handles.ParticlePopup,'Value',2);

    set(handles.axes1,'NextPlot','replacechildren');
    imagesc(handles.Current.Image, handles.Current.clims);

    if get(handles.showParticles, 'Value')

        plotParticle(handles.Tracking.filtParticles, ...
            handles.Current.Ix, handles.isFitPSF);

    end

    if get(handles.showTracks, 'Value')
        plotTracks(handles.Current.Tracks, handles.Current.Ix);
    end

    if isfield(handles.Process,'ROIpos')
        if size(handles.Process.ROIpos,2) > 1
            ROI = handles.Process.ROIpos(:,handles.Current.Ix);
        else
            ROI = handles.Process.ROIpos(:,1);
        end
        plotROI(ROI);

    end
    impixelinfo;

end
set(handles.StatusText,'String','Filtering Particles...Done');
drawnow;
guidata(hObject,handles);




% --------------------------------------------------------------------
function SMEprjMenu_Callback(hObject, eventdata, handles)
% hObject    handle to SMEprjMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
title_str = 'Select Image from which to create an SME projection';
if ~ispc; menu(title_str,'OK'); end
[fname,pname] = uigetfile('*.tif','Select Image from which to create an SME projection');


if fname ~= 0
    set(handles.StatusText,'String','Generating SME projection...');
    drawnow
    I_out = SME_4D(fullfile(pname,fname));

    f_out = ['SME_',fname];
    imwrite(uint16(I_out(:,:,1,1)),fullfile(pname,f_out),'WriteMode','overwrite');
    for j = 2:size(I_out,4)
        imwrite(uint16(I_out(:,:,1,j)),fullfile(pname,f_out),'WriteMode','append');
    end
    for i = 2:size(I_out,3)
        for j = 1:size(I_out,4)
            imwrite(uint16(I_out(:,:,i,j)),fullfile(pname,f_out),'WriteMode','append');
        end
    end
end
set(handles.StatusText,'String','Generating SME projection...Done');
drawnow


