%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function handles = setParamValues(handles)
Profiles = handles.Profiles;
lastProfile = handles.curProfileID;

%set the dropdown contents & value
%update the profile options
nProfiles = length(handles.Profiles);
profile_names = cell(nProfiles+1,1);
for i = 1:nProfiles
    profile_names{i,:} = handles.Profiles(i).Name;
end
profile_names{nProfiles+1,:} = 'New...';
set(handles.ProfilePopup,'String',profile_names)
set(handles.ProfilePopup,'Value',lastProfile);
set(handles.ProfilePopup,'Value',lastProfile);

% Parameters regarding the acquisition
handles.Parameters.Acquisition.pixelSize = Profiles(lastProfile).pixelSize;
handles.Parameters.Acquisition.exposureTime = Profiles(lastProfile).exposureTime;
handles.Parameters.Acquisition.frameTime = Profiles(lastProfile).frameTime;
handles.Parameters.Acquisition.NA = Profiles(lastProfile).objNA;
handles.Parameters.Acquisition.EmWavelength = Profiles(lastProfile).lambda;

%Store the default paramaters in the handles structure
handles.Parameters.DefAcquisition.pixelSize = Profiles(lastProfile).pixelSize;
handles.Parameters.DefAcquisition.exposureTime = Profiles(lastProfile).exposureTime;
handles.Parameters.DefAcquisition.frameTime = Profiles(lastProfile).frameTime;
handles.Parameters.DefAcquisition.NA = Profiles(lastProfile).objNA;
handles.Parameters.DefAcquisition.EmWavelength = Profiles(lastProfile).lambda;

set(handles.pixelSizeNM_edit,'String',num2str(handles.Parameters.Acquisition.pixelSize*1000));
set(handles.exposureTime_edit,'String',num2str(handles.Parameters.Acquisition.exposureTime));
set(handles.frameTime_edit,'String',num2str(handles.Parameters.Acquisition.frameTime));
set(handles.NAedit,'String',num2str(handles.Parameters.Acquisition.NA));
set(handles.lambda_nm_edit,'String',num2str(handles.Parameters.Acquisition.EmWavelength*1000));

% Parameters regarding the track checking
handles.Parameters.discardCheck = Profiles(lastProfile).ShortestTrack;

% Parameters regarding the Analysis
handles.Parameters.Analysis.JHistBinSize = Profiles(lastProfile).JHistBinSize;
handles.Parameters.Analysis.JHistMaxFrameN = Profiles(lastProfile).JHistMaxFrameN;
handles.Parameters.Analysis.MSD_fit_Threshold= Profiles(lastProfile).MSD_fit_Threshold;
handles.Parameters.Analysis.Anisotropy_binT = Profiles(lastProfile).Anisotropy_binT;
handles.Parameters.Analysis.Anisotropy_binD = Profiles(lastProfile).Anisotropy_binD;
handles.Parameters.Analysis.Anisotropy_bootIter = Profiles(lastProfile).Anisotropy_bootIter;

%Parameters regarding the identification of bound molecules
handles.Parameters.Bound.ThreshL = Profiles(lastProfile).ThreshL;
handles.Parameters.Used.Bound.ThreshL = Profiles(lastProfile).ThreshL;
handles.Parameters.Bound.ThreshH = Profiles(lastProfile).ThreshH;
handles.Parameters.Used.Bound.ThreshH = Profiles(lastProfile).ThreshH;
handles.Parameters.Bound.minBoundFrames = Profiles(lastProfile).minBoundFrames;
handles.Parameters.Used.Bound.minBoundFrames = Profiles(lastProfile).minBoundFrames;

%Parameters for automatic ROI detection
handles.Parameters.autoROI.morphRadius = Profiles(lastProfile).autoROI_params.Morphradius;
handles.Parameters.autoROI.filtWindow = Profiles(lastProfile).autoROI_params.filtWindow;
handles.Parameters.autoROI.ROIradius = Profiles(lastProfile).autoROI_params.ROIradius;
handles.Parameters.autoROI.sumTH = Profiles(lastProfile).autoROI_params.sumTH;
handles.Parameters.autoROI.indTH = Profiles(lastProfile).autoROI_params.indTH;


% --------------------------------------------------------------------
function CalcBoundParamsMenu_Callback(hObject, eventdata, handles)
% hObject    handle to CalcBoundParamsMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% Select multiple Files to open;

if isfield(handles, 'Data')
    title_str = 'Select Mat files for the analysis of the residence time';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for the analysis of the residence time',...
        [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
else
    title_str = 'Select Mat files for the analysis of the residence time';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select Mat files for the analysis of the residence time',...
        'MultiSelect','on');
end
if ~iscell(FileNames)
    if FileNames == 0
        FileNames = [];
    end
end
if ~isempty(FileNames)
    % if isfield(handles.Parameters, 'Used') && isfield(handles.Parameters.Used, 'Bound')
    %     if isfield(handles.Parameters.Used,'Analysis')
    %         JHistBinSize = handles.Parameters.Used.Analysis.JHistBinSize;
    %         JHistMaxFrameN = handles.Parameters.Used.Analysis.JHistMaxFrameN;
    %     else
    %         JHistBinSize = handles.Parameters.Analysis.JHistBinSize;
    %         JHistMaxFrameN = handles.Parameters.Analysis.JHistMaxFrameN;
    %     end
    %     maxJump = 12.*...
    %         handles.Parameters.Used.Acquisition.pixelSize;
    %     defPar(1) = handles.Parameters.Used.Acquisition.frameTime;
    % 
    % 
    % else
    JHistBinSize = handles.Parameters.Analysis.JHistBinSize;
    JHistMaxFrameN = handles.Parameters.Analysis.JHistMaxFrameN;
    maxJump = 12*handles.Parameters.Acquisition.pixelSize;

    defPar(1) = handles.Parameters.Acquisition.frameTime;
    % end
    defPar(2) = 0.01; %Probability Threshold
    defPar(3) = 0.5; %Diffusion Coefficient for free molecules
    % Get a dialog input to set the parameters;

    defaults = {num2str(defPar(1)), num2str(defPar(2)), ...
        num2str(defPar(3))};

    prompt = {'Frame Time [s]',...
        'Probability Threshold',...
        'Diffusion Coefficient of Free molecules [um^2/s]'};

    dlgtitle = 'Parameters for histogram of displacements';
    AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);
    if ~isempty(AnalysisParam)
        frameTime = str2double(AnalysisParam{1});
        ProbTh = str2double(AnalysisParam{2});
        D_free = str2double(AnalysisParam{3});

        binEdges = 0:JHistBinSize:maxJump;
    
        % If only one file has been selected change the fileNames variable
        % to a cell array
    
        if ~iscell(FileNames)
            FileNames = {FileNames};
        end
    
        nFiles = length(FileNames);
        %if we have only 1 file it will likely be a trackTable
        if nFiles == 1
            IN = load(fullfile(PathName,FileNames{1}));
            if isfield(IN,'trackTable')
                [Tracks, NParticles, ROIChoice] = compileTracksFromTables(...
                    IN.trackTable,0,...
                    [],...
                    'Tracking');
            else
                [Tracks, NParticles, ROIChoice] = compileTracksFromFiles(...
                    FileNames,PathName,0,...
                    [],...
                    'Tracking');
            end
        else %if more than one file is selected it should be tracking files
            [Tracks, NParticles, ROIChoice] = compileTracksFromFiles(...
                FileNames,PathName,0,...
                [],...
                'Tracking');
        end
    
    
        hwait = waitbar(0,'Compiling Jump Histogram','Name','Calculating Bound Parameters');
        for i = 1:nFiles
            
            [app.tlist, app.rlist, JDH_tmp(:,:,i),jd1{i}] = calculateJDH(Tracks{i},JHistMaxFrameN , binEdges,frameTime);
            waitbar(i/nFiles,hwait);
    
        end
    
    
        close(hwait);
        % Accumulate Jump Histogram
        JDH_tmp = sum(JDH_tmp, 3);
        %Calculate rmin (minimum frame-to-frame displacement for bound particles)
        %This is only accurate when analyzing stably bound molecules

        S1 = sum(JDH_tmp(1,:));
        C1 = cumsum(JDH_tmp(1,:));
        rmin_ind = find(C1 >= (1 - ProbTh)*S1, 1, 'first');
        rmin = app.rlist(rmin_ind);

        % calculate Nmin using the above rmin, and the given frameTime
        % This is only accurate when analyzing stably bound molecules
        [Nmin,~] = calculateNmin(rmin,frameTime,D_free,ProbTh);

        % Calculate rmax
        if Nmin <= size(JDH_tmp,1)
            S2 = sum(JDH_tmp(Nmin,:));
            C2 = cumsum(JDH_tmp(Nmin,:));
            rmax_ind = find(C2 >= (1-ProbTh)*S2,1,'first');
            rmax = app.rlist(rmax_ind);
        else
            rmax = NaN;
        end
        Profiles = handles.Profiles;
        lastProfile = handles.curProfileID;
        Profiles(lastProfile).ThreshL = rmin;
        Profiles(lastProfile).minBoundFrames = Nmin;
        Profiles(lastProfile).ThreshH = rmax;
        handles.Profiles = Profiles;
        handles.curProfileID = lastProfile;

        handles = setParamValues(handles);
        msgbox('Bound Parameters updated for current Profile','Bound Parameters');
        
        QT_location = getQuantiTrackLoc();

       

        save(fullfile(QT_location,'QuantiTrack_localDefaults.mat'), 'Profiles', 'lastProfile');

    end
end
guidata(hObject,handles);


