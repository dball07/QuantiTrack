% --------------------------------------------------------------------
function ParallelUseSelect_Callback(hObject, eventdata, handles)
% hObject    handle to ParallelUseSelect (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

curText = get(hObject,'Text');
if strcmp(curText,'Use Parallel Computing')
    handles.useParallel = 1;
    set(handles.StatusText,'String','Starting parallel pool...');
    drawnow;

    parpool;
    set(hObject,'Text','Use Serial Computing');
    set(handles.StatusText,'String','Starting parallel pool...Done');
    drawnow;
elseif strcmp(curText,'Use Serial Computing')
    handles.useParallel = 0;
    set(handles.StatusText,'String','Closing parallel pool...');
    drawnow;

    delete(gcp('nocreate'));
    set(hObject,'Text','Use Parallel Computing');
    set(handles.StatusText,'String','Closing parallel pool...Done');
    drawnow;
end
guidata(hObject,handles);
drawnow;



% --- Executes on selection change in ProfilePopup.
function ProfilePopup_Callback(hObject, eventdata, handles)
% hObject    handle to ProfilePopup (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hints: contents = cellstr(get(hObject,'String')) returns ProfilePopup contents as cell array
%        contents{get(hObject,'Value')} returns selected item from ProfilePopup
value = get(hObject,'Value');

nProfiles = length(handles.Profiles);

if value > nProfiles % 'New...' selected
    QT_location = getQuantiTrackLoc();
    paramTab = 1; %Opens with Acquisition tab
    profileEditor_gui = QuantiTrack_SetParams_App(handles.figure1,handles.Profiles,...
        value,QT_location, paramTab, get(gcf,'Position'));

    waitfor(profileEditor_gui);

    %Retrieve the preprocessing results
    OUTvars = getappdata(handles.figure1,'QuantiTrackParamEditorVals');
    handles.Profiles = OUTvars{1};
    handles.curProfileID = OUTvars{2};
    
    
else
    handles.curProfileID = value;
    
    
    %check if the tracking database exists
    curD = pwd;
    try cd(handles.Profiles(handles.curProfileID).trackingSaveDir)
    catch ME
        if (strcmp(ME.identifier,'MATLAB:cd:NonExistentFolder'))
            title_str = ['Select the Location where all Tracking ' ...
            'files will be saved'];
            if ~ispc; menu(title_str,'OK'); end
            trackingSaveDir = uigetdir(pwd,['Select the Location where all Tracking ' ...
            'files will be saved']);
            handles.Profiles(handles.curProfileID).trackingSaveDir = trackingSaveDir;
            
        end

    end
    cd(curD);
    Profiles = handles.Profiles;
    lastProfile = handles.curProfileID;
    QT_location = getQuantiTrackLoc();
    save(fullfile(QT_location,'QuantiTrack_localDefaults.mat'), 'Profiles', 'lastProfile');

end
handles = setParamValues(handles);

guidata(hObject,handles);

