function JDH_Open_Callback(hObject, eventdata, handles)
% hObject    handle to JDH_Open_Callback (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
AnalyzeJumpHistogram_App();

function ImportImageJROIs_Callback(hObject, eventdata, handles)
% hObject    handle to ImportImageJROIs_Callback (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

set(handles.StatusText,'String','Importing ROIs...');
drawnow;
%Check if ROI data already exists
if isfield(handles.Process,'ROIpos')
    dlgout = questdlg('Existing ROI data, how to proceed?','Import ROIs','Append', 'Overwrite','Cancel','Cancel');
    if strcmp(dlgout,'Cancel')
        return
    elseif strcmp(dlgout,'Append')
        firstROInum = length(handles.Process.ROIpos) + 1;
    else
        firstROInum = 1;

    end
else
    dlgout = 'Overwrite';
    firstROInum = 1;
end

if isfield(handles.Data,'pathName')
    defPath = handles.Data.pathName;
else
    defPath = pwd;
end

% select the zip file containing the ROIs from ImageJ
title_str = 'Select ImageJ ROI file';
if ~ispc; menu(title_str,'OK'); end
[zipName,zipLocation] = uigetfile('*.zip','Select ImageJ ROI file',defPath,'MultiSelect','off');

if zipName == 0
    return
else
    ROIzipfile = fullfile(zipLocation,zipName);
end
imgSize = [handles.Data.imageStack(1).height handles.Data.imageStack(1).width];

[ROIpos, ROIimage,ROIlabel] = QT_importROIs_ImageJ(ROIzipfile,imgSize,firstROInum);

if strcmp(dlgout,'Append')
    handles.Process.ROIpos = [handles.Process.ROIpos; ROIpos];
    handles.Process.ROIlabel = [handles.Process.ROIlabel; ROIlabel];
    handles.Process.ROIimage = [handles.Process.ROIimage; ROIimage];
else
    handles.Process.ROIpos = ROIpos;
    handles.Process.ROIlabel = ROIlabel;
    handles.Process.ROIimage = ROIimage;
end

set(handles.ROIList,'String',handles.Process.ROIlabel);
set(handles.ROIList,'Value',1);
if size(handles.Process.ROIpos,2) > 1
    ROI = handles.Process.ROIpos(:,handles.Current.Ix);
else
    ROI = handles.Process.ROIpos(:,1);
end

set(handles.ROIClassCur_text,'String','Not Defined');

plotROI(ROI, handles.axes1);
set(handles.StatusText,'String','Importing ROIs...Done');
set(handles.CopyROI,'Enable','on');
set(handles.roiRemovePush,'Enable','on');
set(handles.roiNamePush,'Enable','on');
set(handles.ROIareas2clip_menu,'Enable','on');
set(handles.ChangeROIClass,'Enable','on');

for i = 1:size(handles.Process.ROIimage,1)
    for j = 1:size(handles.Process.ROIimage,2)
        handles.Process.ROIarea_px(i,j) = sum(sum(handles.Process.ROIimage{i,j}));
    end
end


if isfield(handles.Process,'filterStack')
    set(handles.findpeakButton,'Enable','on');
end
drawnow;

guidata(hObject,handles);

