% --------------------------------------------------------------------
function SaveMatNoImage_Callback(hObject, eventdata, handles)
% hObject    handle to SaveMatNoImage (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Assign .mat file where variables will be saved.
defName = [handles.Data.pathName, handles.Data.fileName];
SearchStr = '(.*)\.\w*';
defName = regexprep(defName, SearchStr, '$1');
FilterSpec = {'*.mat'};
[FileNameOut,PathNameOut] = uiputfile(FilterSpec,'Save Variables',defName);
if FileNameOut ~=0
    set(handles.StatusText,'String','Saving MAT file...');
    drawnow;
    Version = 1.0;

    Results.Data.fileName = handles.Data.fileName;
    Results.Data.pathName = handles.Data.pathName;
    Results.Data.nImages = handles.Data.nImages;
    Results.Data.clims = handles.Data.clims;
    Results.Data.MaxBrightnessStack = handles.Data.MaxBrightnessStack;
    Results.Parameters = handles.Parameters.Used;
    Results.Process.ROIClass = handles.Process.ROIClass;
    Results.Process.clims = handles.Process.clims;
    Results.Process.MaxBrightnessStack = handles.Process.MaxBrightnessStack;
    Results.Process.ROIpos = handles.Process.ROIpos;
    Results.Process.ROIimage = handles.Process.ROIimage;
    Results.Process.ROIlabel = handles.Process.ROIlabel;
    Results.Process.RefImage = handles.Process.RefImage;
    Results.Tracking = handles.Tracking;
    Results.Analysis = handles.Analysis;
    Results.PreAnalysis = handles.PreAnalysis;
    Results.isFitPSF = handles.isFitPSF;
    save([PathNameOut, FileNameOut], 'Version','Results', '-v7.3');
    set(handles.StatusText,'String','Saving MAT file...Done');
    drawnow;
end


% --------------------------------------------------------------------
function autoROImenu_Callback(hObject, eventdata, handles)
% hObject    handle to autoROImenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%Check if ROI data already exists
if isfield(handles.Process,'ROIpos')
    dlgout = questdlg('Existing ROI data will be overwritten, Continue?','Automatic ROIs','OK','Cancel','Cancel');
    if strcmp(dlgout,'Cancel')
        return
    end
end

%Check if the path is set
if isfield(handles.Data,'pathName') && ~isempty(handles.Data.pathName)
    defPath = handles.Data.pathName;
else
    defPath = pwd;
end


%Allow user to choose the reference image
title_str = 'Open Reference Image';
if ~ispc; menu(title_str,'OK'); end
[RefFile, RefPath] = uigetfile('*.tif','Open Reference Image',defPath);
if RefFile ~= 0
    set(handles.StatusText,'String','Reading Reference Image...');
    drawnow;
    [RefIm, nImRef] = TIFread(fullfile(RefPath,RefFile));
    set(handles.StatusText,'String','Locating ROIs...');
    drawnow;
    R = handles.Parameters.autoROI.ROIradius;
    currDisk = handles.Parameters.autoROI.morphRadius;
    WindowSz = handles.Parameters.autoROI.filtWindow ;
    Thresh = handles.Parameters.autoROI.indTH;
    th1 = handles.Parameters.autoROI.sumTH;

    [ROIpos, ROIimage,Cent,~,ROIimage_all,Thresh,th1,th2] =autoROIs_moving(RefIm,nImRef,R,WindowSz,currDisk,Thresh,th1,handles.useParallel);
    handles.Parameters.autoROI.sumTH = max(th1);
    handles.Parameters.autoROI.indTH = max(Thresh);

    if isempty(ROIpos)
        warndlg('No ROIs detected, so nothing has been added to the ROI list','No ROIs');
    else

        handles.Process.ROIpos = ROIpos;
        handles.Process.ROIimage = ROIimage;
        handles.Process.ROICentroid = Cent;
        handles.Process.autoROIparamUsed = [Thresh,th1,th2];
        handles.Process.ROIlabel = cell(size(ROIpos,1),1);
        for i = 1:size(ROIpos,1)
            d = num2str(i);

            handles.Process.ROIlabel{i,:} = ['ROI', d];
        end
        set(handles.ROIList,'String',handles.Process.ROIlabel);
        set(handles.ROIList,'Value',1);
        if size(handles.Process.ROIpos,2) > 1
            ROI = handles.Process.ROIpos(:,handles.Current.Ix);
        else
            ROI = handles.Process.ROIpos(:,1);
        end
        plotROI(ROI);
        set(handles.StatusText,'String','Locating ROIs...Done');
        set(handles.CopyROI,'Enable','on');
        set(handles.roiRemovePush,'Enable','on');
        set(handles.roiNamePush,'Enable','on');
        set(handles.ROIareas2clip_menu,'Enable','on');
        set(handles.ChangeROIClass,'Enable','on');
        for i = 1:size(ROIimage,1)
            for j = 1:size(ROIimage,2)
                handles.Process.ROIarea_px(i,j) = sum(sum(ROIimage{i,j}));
            end
        end
    end
    drawnow;

end


guidata(hObject,handles);


