% --- Executes on button press in UpdateDefaultButton.
function UpdateDefaultButton_Callback(hObject, eventdata, handles)
% hObject    handle to UpdateDefaultButton (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

qstring = {'Do you want to overwrite';...
    'the current Profile acquisition parameters?'};
Qst = questdlg(qstring,'Overwrite?');

if strcmp(Qst, 'Yes')
    handles.Profiles(handles.curProfileID).pixelSize = handles.Parameters.Acquisition.pixelSize;
    handles.Profiles(handles.curProfileID).frameTime = handles.Parameters.Acquisition.frameTime;
    handles.Profiles(handles.curProfileID).objNA = handles.Parameters.Acquisition.NA;
    handles.Profiles(handles.curProfileID).lambda = handles.Parameters.Acquisition.EmWavelength;
    Profiles = handles.Profiles;
    lastProfile = handles.curProfileID;
    QT_location = getQuantiTrackLoc();
    save(fullfile(QT_location,'QuantiTrack_localDefaults.mat'), 'Profiles','lastProfile');
    set(hObject,'Enable','off')
    handles.Parameters.DefAcquisition.pixelSize = handles.Parameters.Acquisition.pixelSize;
    handles.Parameters.DefAcquisition.frameTime = handles.Parameters.Acquisition.frameTime;
    handles.Parameters.DefAcquisition.NA = handles.Parameters.Acquisition.NA;
    handles.Parameters.DefAcquisition.EmWavelength = handles.Parameters.Acquisition.EmWavelength;

end
% Update handles structure
guidata(hObject, handles);



