function MSD_merge_Callback(hObject, eventdata, handles)
% hObject    handle to MSD_merge (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

if isfield(handles, 'Data')
    title_str = 'Select tracking files or table to compute MSD curve';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select tracking files or table to compute MSD curve',...
        [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
else
    title_str = 'Select tracking files or table to compute MSD curve';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames,PathName] = uigetfile('.mat',...
        'Select tracking files or table to compute MSD curve',...
        'MultiSelect','on');
end
if ~iscell(FileNames)
    fnames_tmp{1,1} = FileNames;
    FileNames = fnames_tmp;
    
end
if FileNames{1} == 0
    return;
end

defaults = {'10', num2str(handles.Parameters.Acquisition.frameTime)};
prompt = {'Minimum length of tracks',...
    'frame interval (s)'};
dlgtitle = 'Parameters for the Survival Time distribution';
AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);

if isempty(AnalysisParam)
    return
end

minTrkLength = str2double(AnalysisParam{1});
frameTime = str2double(AnalysisParam{2});

MSD_Analysis_App(FileNames,PathName,minTrkLength,frameTime,[], get(gcf,'Position'))
    



