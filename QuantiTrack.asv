% --------------------------------------------------------------------
function TrackIntPlotMenu_Callback(hObject, eventdata, handles)
% hObject    handle to TrackIntPlotMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
if isfield(handles,'PreAnalysis')
    Tracks = handles.PreAnalysis.Tracks_um;
    FrameTime = handles.Parameters.Acquisition.frameTime;

    imStack = handles.Data.imageStack;
    tracks_px = handles.Tracking.Tracks;
    nTrks = max(Tracks(:,4));
    extTracks = [];
    tMax = max(Tracks(:,3));
    set(handles.StatusText,'String','Preparing Tracks for Intensity Plots...');
    drawnow;
    hwait = waitbar(0,'Preparing Tracks for Intensity Plots','Name','Track Intensity');

    for i = 1:nTrks
        %get the current track data (in px and um)
        curT = Tracks(Tracks(:,4) == i,:);
        curTpx = tracks_px(tracks_px(:,4) == i,:);

        %get the last position & frame
        lastFrame = curT(end,3);
        lastPos = curT(end,1:2);
        lastROI = curT(end,5);
        lastPosPx = curTpx(end,1:2);

        nFrames2add = tMax - lastFrame;

        %extend the track to the end of the time-course
        addTrk = zeros(nFrames2add,5);
        addTrk(:,1:2) = repmat(lastPosPx,nFrames2add,1);
        addTrk(:,3) = (lastFrame+1:tMax)';
        addTrk(:,4) = repmat(i,nFrames2add,1);
        addTrk(:,5) = repmat(lastROI,nFrames2add,1);
        if ~isempty(addTrk)
            addTrk = AddAiryIntensity(addTrk,handles.Parameters.Acquisition.pixelSize,imStack);
            addTrk(:,1:2) = repmat(lastPos,nFrames2add,1);
        else
            addTrk = [];
        end

        %concatenate to generate the new tracking data
        extTracks = [extTracks; curT; addTrk];
        waitbar(i/nTrks,hwait,'Preparing Tracks for Intensity Plots','Name','Track Intensity');
    end
    close(hwait);
    Tracks = extTracks;
    set(handles.StatusText,'String','Preparing Tracks for Intensity Plots...Done');
    drawnow;
    TrackPlotter(Tracks,FrameTime,get(gcf,'Position'));
    
else
    set(handles.StatusText,'String','Opening Track Intensity Plotting tool...Done');
    drawnow;
    TrackPlotter([],[],get(gcf,'Position'));
end


