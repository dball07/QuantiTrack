% --------------------------------------------------------------------
function BatchTrack_menu_Callback(hObject, eventdata, handles)
% hObject    handle to BatchTrack_menu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%Set up the parameters for tracking and processing
lpass = str2double(get(handles.lpEdit,'String'));
hpass = str2double(get(handles.hpEdit,'String'));
defPar(1) = lpass;
defPar(2) = hpass;
defPar(3) = str2double(get(handles.thresholdEdit,'String'));
defPar(4) = str2double(get(handles.windowEdit,'String'));
defPar(5) = 1;
defPar(6) = str2double(get(handles.jumpEdit,'String'));
defPar(7) = str2double(get(handles.shTrackEdit,'String'));
defPar(8) = str2double(get(handles.gapsCheck,'String'));
defPar(9) = handles.Parameters.Acquisition.pixelSize;
defPar(10) = handles.Parameters.Acquisition.EmWavelength*1000;
defPar(11) = handles.Parameters.Acquisition.NA;
defPar(12) = handles.Parameters.Acquisition.frameTime;



defaults = {num2str(defPar(1)), num2str(defPar(2)), ...
    num2str(defPar(3)), num2str(defPar(4)), num2str(defPar(5)),...
    num2str(defPar(6)), num2str(defPar(7)), num2str(defPar(8)),...
    num2str(defPar(9)), num2str(defPar(10)), num2str(defPar(11)), num2str(defPar(12))};
prompt = {'Bandpass Lower Limit',...
    'Bandpass Upper Limit',...
    'Threshold',...
    'Window Size',...
    'Fit Gaussian',...
    'Maximum Jump',...
    'Shortest Track',...
    'Gaps to close',...
    'Pixel Size',...
    'Emission wavelength (nm)',...
    'Objective N.A.',....
    'Frame Interval (s)'};
dlgtitle = 'Parameters for Batch Tracking';
AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);
if isempty(AnalysisParam)
    return
end
handles.Parameters.Acquisition.pixelSize = str2double(AnalysisParam{9});
handles.Parameters.Acquisition.frameTime = str2double(AnalysisParam{12});

if isfield(handles,'Data')
    if isfield(handles.Data,'pathName')

        curdir = pwd;
        try cd(handles.Data.pathName);
        catch
            
        end
    end
end
lpass = str2double(AnalysisParam{1});
hpass = str2double(AnalysisParam{2});
threshold = str2double(AnalysisParam{3});
windowSz = str2double(AnalysisParam{4});
isFitPSF = str2double(AnalysisParam{5});
maxJump = str2double(AnalysisParam{6});
shTrack = str2double(AnalysisParam{7});
closeGaps = str2double(AnalysisParam{8}); 
pxSize = str2double(AnalysisParam{9});
frameInterval = str2double(AnalysisParam{12});
lambda = str2double(AnalysisParam{10})/1000;
NA = str2double(AnalysisParam{11});


[handles.Profiles,handles.curProfileID] = QuantiTrack_BatchTrack(lpass,hpass,...
    threshold,windowSz,...
    isFitPSF,maxJump,...
    shTrack,closeGaps,...
    pxSize,frameInterval,...
    lambda,NA,handles.useParallel,handles.Profiles,handles.curProfileID,...
    handles.figure1);

Profiles = handles.Profiles;
lastProfile = handles.curProfileID;
QT_location = getQuantiTrackLoc();

% Profiles(lastProfile).lastCellProtein = lastCellProtein;
% Profiles(lastProfile).lastCondition = lastCondition;
% Profiles(lastProfile).lastSession = lastSession;
% Profiles(lastProfile).lastName = lastName;

save(fullfile(QT_location,'QuantiTrack_localDefaults.mat'), 'Profiles','lastProfile');

if isfield(handles,'Data')
    if isfield(handles.Data,'pathName')

        cd(curdir);
    end
end
guidata(hObject,handles);


% --------------------------------------------------------------------
function ResTimeMerge_Histone_Callback(hObject, eventdata, handles)
% hObject    handle to ResTimeMerge_Histone (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

PB_type = questdlg('Which Photobleaching correction to use?','PB Correction Method', 'Histone Tracks','Number of Particles', 'None','Histone Tracks');
Profiles = handles.Profiles;
lastProfile = handles.curProfileID;


%Get the histone tracking files
if strcmp(PB_type, 'Histone Tracks')
    title_str = 'Select tracking files or table from Histones';
    if ~ispc; menu(title_str,'OK'); end
    [FileNames_PB,PathName_PB] = uigetfile('.mat',...
        'Select tracking files or table from Histones',...
        [Profiles(lastProfile).trackingSaveDir, filesep], 'MultiSelect','on');
    PB_method = 1;
    if ~iscell(FileNames_PB)
        tmp{1,:} = FileNames_PB;
        FileNames_PB = tmp;

    end
    if FileNames_PB{1} == 0
        return
    end

elseif strcmp(PB_type, 'Number of Particles')
    FileNames_PB = [];
    PB_method = 2;
    PathName_PB = [];
else
    FileNames_PB = [];
    PB_method = 0;
    PathName_PB = [];
end
title_str = 'Select tracking files or table for the analysis of the residence time';
if ~ispc; menu(title_str,'OK'); end
[FileNames_TF,PathName_TF] = uigetfile('.mat',...
        'Select tracking files or table for the analysis of the residence time',...
        fullfile(Profiles(lastProfile).trackingSaveDir, Profiles(lastProfile).lastCellProtein), 'MultiSelect','on');

% if isfield(handles, 'Data')
%     [FileNames_TF,PathName_TF] = uigetfile('.mat',...
%         'Select tracking files or table for the analysis of the residence time',...
%         [handles.Data.pathName, handles.Data.fileName],'MultiSelect','on');
% else
%     [FileNames_TF,PathName_TF] = uigetfile('.mat',...
%         'Select tracking files or table for the analysis of the residence time',...
%         'MultiSelect','on');
% end

if ~iscell(FileNames_TF)
    tmp{1,:} = FileNames_TF;
    FileNames_TF = tmp;
end
if FileNames_TF{1} == 0
    return;
end

% Set the parameters for the analysis of the residence time;

if isfield(handles.Parameters, 'Used') && isfield(handles.Parameters.Used, 'Bound')

    defPar(1) = handles.Parameters.Used.Bound.ThreshL;
    defPar(2) = handles.Parameters.Used.Bound.ThreshH;
    defPar(3) = handles.Parameters.Used.Bound.minBoundFrames;
    if isfield(handles.Parameters.Used,'Acquisition')
        defPar(4) = handles.Parameters.Used.Acquisition.frameTime;
    else
        defPar(4) = handles.Parameters.Acquisition.frameTime;
    end


else
    defPar(1) = handles.Parameters.Bound.ThreshL;
    defPar(2) = handles.Parameters.Bound.ThreshH;
    defPar(3) = handles.Parameters.Bound.minBoundFrames;
    defPar(4) = handles.Parameters.Acquisition.frameTime;


end

defaults = {num2str(defPar(1)), num2str(defPar(2)), ...
    num2str(defPar(3)), num2str(defPar(4)), num2str(10)};
prompt = {'Maximum Jump between consecutive frames',...
    'Maximum end to end distance',...
    'Minimum length of bound tracks',...
    'Frame Time',...
    'Minimum number of Tracks in Survival to Fit'};
dlgtitle = 'Parameters for the Survival Time distribution';
AnalysisParam = inputdlg(prompt,dlgtitle, 1, defaults);
if ~isempty(AnalysisParam)
    AnalysisParam{6} = PB_method;

    % Send parameters and file names to the residence time GUI
    AnalyzeResTimes_App(1,PathName_PB,FileNames_PB,PathName_TF,FileNames_TF,AnalysisParam,get(gcf,'Position'));
end


% --------------------------------------------------------------------
function LoadFiltImageMenu_Callback(hObject, eventdata, handles)
% hObject    handle to LoadFiltImageMenu (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

if isfield(handles.Process,'filterStack')
    replaceFilt = questdlg('Filtered Image Exists, Do you want to overwrite it?','Replace Filtered Image','Yes','No','No');
else
    replaceFilt = 'Yes';
end

if strcmp(replaceFilt,'Yes')
    title_str = 'Select the filtered image stack';
    if ~ispc; menu(title_str,'OK'); end
    [fname, pname] = uigetfile('*.tif','Select the filtered image stack');
    [handles.Process.filterStack, nImages] = TIFread(fullfile(pname,fname));

    if nImages ~= handles.Data.nImages
        warndlg('Warning, the number of images in the filtered stack does not match the number of images in the raw stack');
        return;
    end
    for i = 1:nImages
        handles.Process.filterStack(i).data = double(handles.Process.filterStack(i).data);
    end

    set(handles.StatusText,'String','Filtering Images... Done');
    drawnow;
    handles.Process.clims = [min(min(handles.Process.filterStack(1).data))...
        max(max(handles.Process.filterStack(1).data))];
    MaxBrightness = zeros(handles.Data.nImages,1);
    for i = 1:handles.Data.nImages
        MaxBrightness(i) = max(handles.Process.filterStack(i).data(:));
    end
    handles.Process.MaxBrightnessStack = 2*max(MaxBrightness); %give a 100% buffer above the maximum

    set(handles.imagePopup, 'Enable', 'on');


    if get(handles.imagePopup, 'Value') ==2
        handles.Current.Image = ...
            handles.Process.filterStack(handles.Current.Ix).data;
        handles.Current.clims = handles.Process.clims;
        set(handles.BlackValSlider,'Min',0,'Max',handles.Process.MaxBrightnessStack,'SliderStep',[1/(handles.Process.MaxBrightnessStack-1),10/(handles.Process.MaxBrightnessStack-1)]);
        set(handles.WhiteValSlider,'Min',0,'Max',handles.Process.MaxBrightnessStack,'SliderStep',[1/(handles.Process.MaxBrightnessStack-1),10/(handles.Process.MaxBrightnessStack-1)]);

        set(handles.BlackValEdit,'String',num2str(handles.Current.clims(1)));
        set(handles.BlackValSlider,'Value',handles.Current.clims(1));
        set(handles.WhiteValEdit,'String',num2str(handles.Current.clims(2)));
        set(handles.WhiteValSlider,'Value',handles.Current.clims(2));
        set(handles.axes1,'NextPlot','replacechildren');
        imagesc(handles.Current.Image,handles.Current.clims);
    end
    %Enable the find Peaks controls
    set(handles.findpeakButton,'Enable','on');
    set(handles.fitPSF,'Enable','on');
    set(handles.thresholdEdit,'Enable','on');
    set(handles.windowEdit,'Enable','on');
    set(handles.SaveFilterMenu,'Enable','on');

end

% Update handles structure
guidata(hObject, handles);

